# Copy to .env (production: /opt/wechat-bot/.env, owner root, mode 600; systemd reads it as EnvironmentFile).
# Never commit the real file.

# Token typed into the 公众号 backend (微信开发者平台 → 公众号 → 域名与消息推送配置 → 消息推送).
# Without it the /mp server does not start. Generate one: python3 -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(32)))"
WXBOT_MP_TOKEN=

# MonashGuide personal account via jwping/wxbot (docs/OPERATIONS.md §5b). Both empty = off.
# WXBOT_PCWX_API=http://127.0.0.1:8110
# WXBOT_PCWX_SECRET=
# WXBOT_PCWX_LISTEN=172.17.0.1:8112
# The owner's wxid: 待答 notes go to his WeChat (and he is @-ed in groups) instead of ClawBot.
# WXBOT_OWNER_WXID=

# Optional overrides (defaults shown)
# WXBOT_HOME=/opt/wechat-bot
# WXBOT_HUB_API=http://127.0.0.1:8100/api/v1
# When Monash Hub is not on this machine (docs/OPERATIONS.md §9): its public API, and where mamo-sync downloads
# mamo.ts and the i18n files from.
# WXBOT_HUB_API=https://monashhub.secureview.tech/api/v1
# WXBOT_HUB_FILES_URL=https://raw.githubusercontent.com/Waldo0926/monash-hub/main
# Handbook year to answer from (the Hub moves to next year in October; pin this year until the new year starts)
# WXBOT_HUB_YEAR=2026
# Campus whose official pages the Hub ranks first (empty: none)
# WXBOT_HUB_CAMPUS=malaysia
# WXBOT_MP_PORT=8102
# WXBOT_OWNER_NAME=Waldo
# WXBOT_QA_STRONG=0.6
# WXBOT_QA_WEAK=0.42
# WXBOT_QA_NEAR=0.3
# WXBOT_QA_MARGIN=0.03
# WXBOT_ARTICLE_MIN=0.5
# WXBOT_ARTICLE_LEAD=0.7
# WXBOT_OUTBOX_DAYS=30
# WXBOT_LOG_DAYS=90
# WXBOT_PENDING_QUIET_S=90
# WXBOT_PENDING_MERGE_S=1800

# RAG mode (docs/OPERATIONS.md §10). Any WXBOT_RAG line makes deploy/install.sh install requirements-rag.txt.
# WXBOT_RAG=0
# WXBOT_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# WXBOT_RAG_LEX_MIN=0.3
# WXBOT_RAG_VEC_MIN=0.45
# The model the RAG answer uses (free tiers only). Zhipu glm-4-flash is the default; Groq for example:
# WXBOT_LLM_BASE=https://api.groq.com/openai/v1  WXBOT_LLM_MODEL=openai/gpt-oss-120b  WXBOT_LLM_EXTRA='{"reasoning_effort": "low"}'
# (or qwen/qwen3.8-27b with '{"reasoning_effort": "none"}'; both were faster and more often right than glm-4-flash, docs/EVAL.md)
# Put WXBOT_LLM_EXTRA in single quotes: systemd and the shell both strip the double quotes of bare JSON.
# WXBOT_LLM_BASE=https://open.bigmodel.cn/api/paas/v4
# WXBOT_LLM_MODEL=glm-4-flash
# WXBOT_LLM_KEY=
# WXBOT_LLM_TIMEOUT=8

# Only for the unused `python -m wxbot mamo-sync-api` (see issue #11)
# WXBOT_MP_APPID=
# WXBOT_MP_SECRET=
