# Copy to .env (mode 600); a systemd unit can read it as EnvironmentFile.
# Never commit the real file.

# Token typed into the 公众号 backend (微信开发者平台 → 公众号 → 域名与消息推送配置 → 消息推送).
# Without it the /mp server does not start. Generate one: python3 -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(32)))"
WXBOT_MP_TOKEN=

# Optional overrides (defaults shown)
# WXBOT_HOME=/path/to/mumguide-wechat-bot
# WXBOT_HUB_API=http://127.0.0.1:8100/api/v1
# WXBOT_MP_PORT=8102
# WXBOT_OWNER_NAME=Waldo
# WXBOT_QA_STRONG=0.6
# WXBOT_QA_WEAK=0.42
# WXBOT_ARTICLE_MIN=0.5
# WXBOT_ARTICLE_LEAD=0.7

# Only for the unused `python -m wxbot mamo-sync-api`
# WXBOT_MP_APPID=
# WXBOT_MP_SECRET=
